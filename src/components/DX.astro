---
const cases = [
  {
    title: "公式LINE連携システム",
    issue: "問い合わせ・申込対応が手作業で分散し、リアルタイムに追えていなかった。",
    approach:
      "①kintoneのformbridgeでフォーム受付を行い、Cloudflare Workersで中継処理、回答内容をLINEへ返す。
       ②GASでLINE公式アカウントとformbridgeを連携してkintoneへ情報を集約。
       ①②ともにPower AutomateでMicrosoft Teamsへ通知設定。",
    stack: ["kintone", "formbridge", "Cloudflare Workers", "GAS", "LINE公式アカウント", "Power Automate"],
    result: "対応工数の削減とリアルタイム通知を実現。",
  },
  {
    title: "イベント会計システム構築(収支報告)",
    issue: "現金出納実績、全体・チーム別のP&Lや予算実績対比を集計して、関係者にわかりやすく報告する必要があった。",
    approach:
      "入出金フォームをfombridgeで作成、チームリーダー承認機能を経てkintoneへ会計実績を集約、そこから収支連携アプリをつなげ、収支報告書を作成。<br>
       都度経理へのTeams通知を流し共有体制をとった",
    stack: ["kintone", "fombridge", "kViewer", "PowerAutomate"],
    result: "チーム間・経理への報告が明確になり、素早い共有体制を確立。",
  },
  {
    title: "営業スマホ受注アプリ",
    issue: "営業の受注業務が非効率で、基幹システムとの連携も煩雑だった。",
    approach:
      "kintone（fombridge）でスマホ完結の受注アプリを構築し、kintoneと基幹システムを連携するPower Automateを設計・文書化。",
    stack: ["kintone", "fombridge", "Power Automate"],
    result: "提案書を作成し可視化、営業の意見を反映しながら開発を進めた。",
  },
];
---
<section class="section" id="dx">
  <div class="container">
    <p class="eyebrow">DX / Automation</p>
    <h2 class="section-title">業務改善・自動化の実績</h2>
    <p class="section-lead">
      営業事務としての実務課題を起点に、ノーコード/ローコードと軽量なコードを組み合わせて解決してきた事例です。
    </p>

    <div class="cases">
      {cases.map((c, i) => (
        <article class="case-card card">
          <div class="case-head">
            <span class="ledger-no">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="case-title">{c.title}</h3>
          </div>

          <dl class="case-detail">
            <div>
              <dt>課題</dt>
              <dd>{c.issue}</dd>
            </div>
            <div>
              <dt>アプローチ</dt>
              <dd>{c.approach}</dd>
            </div>
            <div>
              <dt>成果</dt>
              <dd>{c.result}</dd>
            </div>
          </dl>

          <div class="case-tags">
            {c.stack.map((s) => <span class="tag is-green">{s}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cases {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  .case-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .case-title {
    font-size: var(--step-2);
  }
  .case-detail {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .case-detail dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-accent-deep);
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
  .case-detail dd {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 68ch;
  }
  .case-tags {
    margin-top: 1.4rem;
  }
</style>
