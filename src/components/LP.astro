---
const lps = [
  {
    title: "DX事例共有セミナー 参加受付LP",
    desc: "ノーコード・ローコードで業務改善を実現した事例を紹介するオンラインセミナーの参加受付ページ。当日のタイムスケジュールをそのまま縦のタイムラインとして見せる構成にしました。",
    tags: ["LP制作", "HTML/CSS/JS"],
    url: "https://lp-seminar-nine.vercel.app/",
    image: "/lp/seminar-hero.jpg",
  },
  {
    title: "Nextep — IT/Web業界特化 転職エージェントLP",
    desc: "未経験からIT/Web業界への転職を支援するエージェントのLP。「相談→書類添削→面接対策→内定」の4ステップを、実際に登る階段として可視化しました。",
    tags: ["LP制作", "HTML/CSS/JS"],
    url: "https://lp-career.vercel.app/",
    image: "/lp/career-hero.jpg",
  },
];
---
<section class="section" id="lp">
  <div class="container">
    <p class="eyebrow">Landing Pages</p>
    <h2 class="section-title">LP制作 2選</h2>
    <p class="section-lead">
      訴求内容に合わせた構成・デザインを設計したランディングページです。
    </p>

    <div class="grid cols-2 lp-grid">
      {lps.map((lp) => (
        <a class="card lp-card" href={lp.url} target="_blank" rel="noopener">
          <div class="lp-thumb">
            <img src={lp.image} alt={lp.title} loading="lazy" />
          </div>
          <h3 class="lp-title">{lp.title}</h3>
          <p class="lp-desc">{lp.desc}</p>
          <div class="lp-tags">
            {lp.tags.map((t) => <span class="tag is-accent">{t}</span>)}
          </div>
          <span class="lp-link">サイトを見る →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .lp-grid {
    margin-top: 2.5rem;
  }
  .lp-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .lp-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px rgba(32,36,43,0.35);
  }
  .lp-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    margin-bottom: 1.2rem;
  }
  .lp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .lp-title {
    font-size: var(--step-2);
  }
  .lp-desc {
    color: var(--color-muted);
    margin-top: 0.6rem;
  }
  .lp-tags {
    margin-top: 1rem;
  }
  .lp-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    border-bottom: 1px solid var(--color-ink);
  }
</style>
