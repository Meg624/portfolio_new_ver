---
const sites = [
  {
    title: "Atelier Sonorité",
    role: "コーディング / HTML/CSS/JS構築",
    desc: "ピアノ専門店ウェブサイト。上質を求める方へ、ピアノの魅力を伝えるために制作しました。",
    tags: ["HTML/CSS/JS"],
    url: "https://piano-atelier-sigma.vercel.app/",
  },
  {
    title: "OneCup",
    role: "コーディング / HTML/CSS/JS構築",
    desc: "世界のコーヒー好きへ、コーヒーの魅力を伝えるために制作しました。",
    tags: ["HTML/CSS/JS", "レスポンシブ対応"],
    url: "https://one-cup.vercel.app/",
  },
  {
    title: "London-diary",
    role: "コーディング / 保守運用",
    desc: "ロンドン旅行のブログサイト。WordPressで構築し、SEO対策を施して運用しています。",
    tags: ["WordPress", "SEO対応"],
    url: "#",
    images: ["/works/london-front.jpg", "/works/london-admin.jpg"],
  },
];
---
<section class="section" id="works">
  <div class="container">
    <p class="eyebrow">Web Sites</p>
    <h2 class="section-title">Webサイト制作 3選</h2>
    <p class="section-lead">
      コーディングとCMS構築を担当したサイトです。制作背景と対応範囲を中心に紹介します。
    </p>

    <div class="ledger">
      {sites.map((s, i) => (
        <article class="ledger-row work-row">
          <span class="ledger-no">{String(i + 1).padStart(2, "0")}</span>
          <div class="work-body">
            <h3 class="work-title">{s.title}</h3>
            <p class="work-role">{s.role}</p>

            {s.images && s.images.length > 0 && (
              <div class="work-images">
                {s.images.map((img) => (
                  <img src={img} alt={s.title} loading="lazy" />
                ))}
              </div>
            )}

            <p class="work-desc">{s.desc}</p>
            <div class="work-tags">
              {s.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            {s.url && s.url !== "#" ? (
              <a class="work-link" href={s.url} target="_blank" rel="noopener">サイトを見る →</a>
            ) : (
              <p class="work-note">公開準備中(画面キャプチャを掲載しています)</p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ledger {
    margin-top: 2.5rem;
  }
  .work-title {
    font-size: var(--step-2);
  }
  .work-role {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent-deep);
    margin: 0.5rem 0 0.8rem;
  }
  .work-desc {
    color: var(--color-muted);
    max-width: 56ch;
  }
  .work-tags {
    margin-top: 1rem;
  }
  .work-images {
    margin: 1rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    max-width: 640px;
  }
  .work-images img {
    width: 100%;
    display: block;
    border: 1px solid var(--color-line);
    border-radius: 2px;
  }
  .work-note {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .work-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-ink);
  }
</style>