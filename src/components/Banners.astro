---
const banners = [
  { file: "banner-01.png", label: "ECサイト SALE告知" },
  { file: "banner-02.png", label: "飲食店 新メニュー告知" },
  { file: "banner-03.png", label: "不動産 物件紹介" },
  { file: "banner-04.png", label: "フィットネスジム キャンペーン" },
  { file: "banner-05.png", label: "IT企業 採用バナー" },
  { file: "banner-06.png", label: "美容サロン キャンペーン" },
  { file: "banner-07.png", label: "学習塾 冬期講習" },
  { file: "banner-08.png", label: "OneCup(カフェ)期間限定ドリンク" },
  { file: "banner-09.png", label: "DXセミナー告知" },
  { file: "banner-10.png", label: "地域夏祭り 告知" },
];
---
<section class="section" id="banners">
  <div class="container">
    <p class="eyebrow">Banners</p>
    <h2 class="section-title">バナー制作 {banners.length}選</h2>
    <p class="section-lead">
      業界・訴求内容ごとに配色とタイポグラフィを変え、幅広いバナー制作に対応できることを意識しました。
    </p>

    <div class="banner-grid">
      {banners.map((b, i) => (
        <figure class="banner-item">
          <img
            src={`/banners/${b.file}`}
            alt={b.label}
            loading="lazy"
            width="640"
            height="400"
          />
          <figcaption>
            <span class="banner-no">{String(i + 1).padStart(2, "0")}</span>
            {b.label}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .banner-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .banner-item {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--color-bg-raised);
  }
  .banner-item img {
    width: 100%;
    height: auto;
    display: block;
  }
  .banner-item figcaption {
    padding: 0.8rem 1rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .banner-no {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  @media (max-width: 780px) {
    .banner-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
