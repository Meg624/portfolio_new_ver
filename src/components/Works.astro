---
const sites = [
  {
    title: "サイト名を入力",
    role: "コーディング / WordPress構築",
    desc: "誰向けに、何を解決するために作ったサイトかをここに記載してください。",
    tags: ["WordPress", "HTML/CSS/JS"],
    url: "#",
  },
  {
    title: "サイト名を入力",
    role: "コーディング / Astro構築",
    desc: "誰向けに、何を解決するために作ったサイトかをここに記載してください。",
    tags: ["Astro", "レスポンシブ対応"],
    url: "#",
  },
  {
    title: "サイト名を入力",
    role: "コーディング / 保守運用",
    desc: "誰向けに、何を解決するために作ったサイトかをここに記載してください。",
    tags: ["WordPress", "SEO対応"],
    url: "#",
  },
];
---
<section class="section" id="works">
  <div class="container">
    <p class="eyebrow">Web Sites</p>
    <h2 class="section-title">Webサイト制作 3選</h2>
    <p class="section-lead">
      コーディングとCMS構築を担当したサイトです。制作背景と対応範囲を中心に紹介します。
    </p>

    <div class="ledger">
      {sites.map((s, i) => (
        <article class="ledger-row work-row">
          <span class="ledger-no">{String(i + 1).padStart(2, "0")}</span>
          <div class="work-body">
            <h3 class="work-title">{s.title}</h3>
            <p class="work-role">{s.role}</p>
            <p class="work-desc">{s.desc}</p>
            <div class="work-tags">
              {s.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <a class="work-link" href={s.url}>サイトを見る →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ledger {
    margin-top: 2.5rem;
  }
  .work-title {
    font-size: var(--step-2);
  }
  .work-role {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent-deep);
    margin: 0.5rem 0 0.8rem;
  }
  .work-desc {
    color: var(--color-muted);
    max-width: 56ch;
  }
  .work-tags {
    margin-top: 1rem;
  }
  .work-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-ink);
  }
</style>
