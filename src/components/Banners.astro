---
const banners = [
  {
    title: "ジム",
    image: "/banners/gym.jpg",
  },
  {
    title: "不動産",
    image: "/banners/realestate.jpg",
  },
  {
    title: "飲食店",
    image: "/banners/restaurant.jpg",
  },
  {
    title: "美容サロン",
    image: "/banners/salon.jpg",
  },
];
---

<section class="section" id="banners">
  <div class="container">
    <p class="eyebrow">Banners</p>
    <h2 class="section-title">バナー制作 {banners.length}選</h2>
    <p class="section-lead">
      用途（広告・告知・SNS投稿など）に合わせて制作したバナーです。
    </p>

    <div class="banner-grid">
      {banners.map((banner) => (
        <div class="banner-thumb">
          <img
            src={banner.image}
            alt={banner.title}
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .banner-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .banner-thumb {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-bg-raised);
    transition: transform .3s ease, box-shadow .3s ease;
  }

  .banner-thumb:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,.12);
  }

  .banner-thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .banner-grid {
      grid-template-columns: 1fr;
    }
  }
</style>