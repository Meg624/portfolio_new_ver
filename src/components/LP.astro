---
const lps = [
  {
    title: "LP名を入力",
    desc: "訴求対象・目的(申込/購入/資料請求など)をここに記載してください。",
    tags: ["LP制作", "HTML/CSS"],
  },
  {
    title: "LP名を入力",
    desc: "訴求対象・目的(申込/購入/資料請求など)をここに記載してください。",
    tags: ["LP制作", "WordPress"],
  },
];
---
<section class="section" id="lp">
  <div class="container">
    <p class="eyebrow">Landing Pages</p>
    <h2 class="section-title">LP制作 2選</h2>
    <p class="section-lead">
      訴求内容に合わせた構成・デザインを設計したランディングページです。
    </p>

    <div class="grid cols-2 lp-grid">
      {lps.map((lp) => (
        <div class="card lp-card">
          <div class="lp-thumb" aria-hidden="true"></div>
          <h3 class="lp-title">{lp.title}</h3>
          <p class="lp-desc">{lp.desc}</p>
          <div class="lp-tags">
            {lp.tags.map((t) => <span class="tag is-accent">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lp-grid {
    margin-top: 2.5rem;
  }
  .lp-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: repeating-linear-gradient(
      135deg,
      var(--color-line) 0px,
      var(--color-line) 1px,
      transparent 1px,
      transparent 10px
    );
    border: 1px solid var(--color-line);
    border-radius: 2px;
    margin-bottom: 1.2rem;
  }
  .lp-title {
    font-size: var(--step-2);
  }
  .lp-desc {
    color: var(--color-muted);
    margin-top: 0.6rem;
  }
  .lp-tags {
    margin-top: 1rem;
  }
</style>
